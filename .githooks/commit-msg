#!/bin/sh
# Require a scoped Conventional Commit subject, at most 72 characters.

message_file="$1"
first_line=$(sed -n '1p' "$message_file")

types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
if ! printf '%s\n' "$first_line" | grep -Eq "^(${types})\([A-Za-z0-9_./-]+\)!?: [^[:space:]](.*[^[:space:]])?$"; then
    printf '%s\n' \
        "commit-msg: the first line does not follow Conventional Commits:" \
        "  $first_line" \
        "" \
        "  expected: type(scope): short description" \
        "  example:  ci(release): publish tagged paclets" >&2
    exit 1
fi

if [ ${#first_line} -gt 72 ]; then
    printf '%s\n' \
        "commit-msg: the first line is longer than 72 characters (${#first_line})." >&2
    exit 1
fi
